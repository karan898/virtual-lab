{
  "name": "netlab-backend",
  "version": "1.0.0",
  "description": "Virtual Networking Lab — Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "jest --runInBand --forceExit",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@kubernetes/client-node": "0.21.0",
    "argon2": "0.31.2",
    "axios": "1.7.2",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "7.3.1",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "kafkajs": "2.2.4",
    "pg": "8.11.5",
    "prom-client": "15.1.2",
    "ws": "8.17.1",
    "zod": "3.23.8",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.14.0",
    "@types/pg": "8.11.6",
    "@types/uuid": "9.0.8",
    "@types/ws": "8.5.10",
    "@types/jest": "29.5.12",
    "jest": "29.7.0",
    "ts-jest": "29.2.2",
    "tsx": "4.15.6",
    "typescript": "5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"]
  }
}
